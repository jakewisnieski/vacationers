# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Neon Postgres connection string.
# Use the POOLED connection string (Neon console → Connection Details →
# "Pooled connection") — it's the right one for serverless / Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Owner bootstrap for `npm run db:seed` (#5). Optional — defaults to Jake's
# account if unset.
# OWNER_EMAIL="you@example.com"
