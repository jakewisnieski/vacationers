# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Neon Postgres connection string.
# Use the POOLED connection string (Neon console → Connection Details →
# "Pooled connection") — it's the right one for serverless / Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Owner bootstrap for `npm run db:seed` (#5). Optional — defaults to Jake's
# account if unset.
# OWNER_EMAIL="you@example.com"

# --- Auth.js / NextAuth (#13) ---
# Session-signing secret. Generate with `npx auth secret` or
# `openssl rand -base64 32`.
AUTH_SECRET=""

# Google OAuth client — identity scopes only, no calendar. Create at
# https://console.cloud.google.com (APIs & Services → Credentials → OAuth client
# ID → Web application). Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Calendar token encryption (#6, scaffolding) ---
# 32-byte AES-256-GCM key, base64. Generate with `openssl rand -base64 32`.
# Unused until the calendar opt-in slice, but required by src/lib/crypto.ts.
CALENDAR_TOKEN_ENC_KEY=""
