// Vacationers — Prisma schema.
// The relational spine (#12): a mutable, owner-managed member set; Trip as a
// first-class entity; per-trip participation. Auth adapter tables (User /
// Account / Session) land with the auth slice (#13). Forward-seam fields for
// Calendar (#6) and idea-sourcing (#7) are modeled now but unused until their
// slices — see the comments on each.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A person in the group. The roster is a mutable, owner-managed set (#5):
/// exactly one owner (Jake), everyone else flat. A Member row is materialized
/// when an allowlisted email signs in for the first time; the owner is
/// bootstrapped by the seed.
model Member {
  id          String   @id @default(cuid())
  // citext: email identity + the #5 allowlist gate must be case-insensitive so
  // an invite/sign-in never mismatches on letter case (jake@ vs Jake@).
  email       String   @unique @db.Citext
  name        String?
  image       String?
  /// Per-member avatar accent, drawn from the Nightfall palette (#9).
  accentColor String?
  isOwner     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  participations     TripParticipant[]
  calendarConnection CalendarConnection?
  ideas              Idea[]
  activities         Activity[]
  ideaVotes          IdeaVote[]
  pollsAuthored      Poll[]
  pollVotes          PollVote[]
  comments           Comment[]
}

/// The DB-authoritative invite allowlist (#5). An email must have an entry here
/// to be admitted at sign-in; non-members are hard-bounced. Owner-managed via
/// the in-app roster screen. Distinct from Member: an email is invited here
/// before (and independently of) ever signing in and becoming a Member.
model AllowlistEntry {
  id        String   @id @default(cuid())
  // citext — case-insensitive to match Member.email (the allowlist gate, #5).
  email     String   @unique @db.Citext
  invitedAt DateTime @default(now())
}

enum TripStatus {
  planning
  locked
  completed
  archived
}

/// A first-class trip — one per year, past trips accrue (#5). Access is
/// group-level (every Member can see every Trip); who is going is modeled
/// separately via TripParticipant.
model Trip {
  id          String     @id @default(cuid())
  year        Int
  destination String?
  startDate   DateTime?  @db.Date
  endDate     DateTime?  @db.Date
  status      TripStatus @default(planning)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  participants TripParticipant[]
  ideas        Idea[]
  activities   Activity[]
  polls        Poll[]
}

/// Per-trip participation — the dashboard's "who's in." Availability /
/// date-finding overlaps only a trip's participants, not the whole roster (#5).
model TripParticipant {
  id       String   @id @default(cuid())
  tripId   String
  memberId String
  joinedAt DateTime @default(now())

  /// Forward seam (#6): locking a trip pushes one all-day, multi-day event to
  /// each participant's primary Google Calendar; we store its event id here so
  /// the event can be updated or removed later. Null until the trip is synced.
  calendarEventId String?

  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([tripId, memberId])
}

/// Forward seam (#6): a member's opt-in Google Calendar connection. Calendar is
/// a separate opt-in from sign-in (#5), so this is absent until the member
/// connects. The refresh token is stored AES-GCM encrypted (key in Vercel's
/// secret store) — never in plaintext.
model CalendarConnection {
  id                    String   @id @default(cuid())
  memberId              String   @unique
  encryptedRefreshToken String
  scopes                String?
  connectedAt           DateTime @default(now())
  updatedAt             DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

enum IdeaStatus {
  /// Qwen3-imported and awaiting owner review before it surfaces (#7).
  suggested
  approved
  rejected
}

/// The destination-ideas board (#26, v0.2.0): each member posts where they'd
/// like the trip to go. Member-authored ideas default to `approved` and show
/// immediately; the offline Qwen3 import (v0.4.0) lands rows as `suggested`
/// awaiting owner review, so `author` is nullable (imported ideas have no member
/// author). `description` and `url` are the optional pitch + reference link.
model Idea {
  id          String     @id @default(cuid())
  tripId      String
  authorId    String?
  title       String
  description String?
  url         String?
  status      IdeaStatus @default(approved)
  createdAt   DateTime   @default(now())

  trip   Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  author Member? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  votes  IdeaVote[]
}

/// A member's upvote on a destination idea (#28, v0.2.0): a lightweight signal
/// to surface the group's favorites on the ideas board. At most one per member
/// per idea — enforced by the unique constraint, so voting is an idempotent
/// toggle. Both sides cascade: a vote disappears with its idea or its member.
model IdeaVote {
  id        String   @id @default(cuid())
  ideaId    String
  memberId  String
  createdAt DateTime @default(now())

  idea   Idea   @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([ideaId, memberId])
}

/// The things-to-do board (#27, v0.2.0): a per-trip shared list of activities
/// members want to do at the destination. `note` + `url` are the optional
/// detail + reference link. `author` is nullable (SetNull) so an activity
/// outlives the poster's Member row if they're removed; there is no import seam
/// here (unlike Idea), so author-less rows only arise from a removed member.
model Activity {
  id        String   @id @default(cuid())
  tripId    String
  authorId  String?
  title     String
  note      String?
  url       String?
  createdAt DateTime @default(now())

  trip   Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  author Member? @relation(fields: [authorId], references: [id], onDelete: SetNull)
}

/// A structured poll on a trip (#29, v0.2.0): a question with 2+ options the
/// group votes on to settle a planning decision (which week, which rental…).
/// Single-choice for v1 — at most one vote per member per poll (see PollVote).
/// `author` is nullable (SetNull) so a poll outlives its creator's Member row if
/// they're removed. `closedAt` marks it closed: it then takes no new votes but
/// still shows results. Options and votes cascade with the poll.
model Poll {
  id        String    @id @default(cuid())
  tripId    String
  authorId  String?
  question  String
  closedAt  DateTime?
  createdAt DateTime  @default(now())

  trip    Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  author  Member?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  options PollOption[]
  votes   PollVote[]
}

/// One selectable option on a poll (#29). `position` preserves the author's
/// input order for a stable results display (options render in the order typed).
/// Deleting the poll cascades its options — and each option's votes.
model PollOption {
  id       String @id @default(cuid())
  pollId   String
  label    String
  position Int

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]
}

/// A member's single vote on a poll (#29): single-choice for v1, so at most one
/// per member per poll — enforced by `@@unique([pollId, memberId])`. `pollId` is
/// stored alongside `optionId` precisely so that constraint can hold at the DB
/// level (the action guarantees the option belongs to the poll). Changing a vote
/// moves it (updates `optionId`); it never adds a second row. Cascades with the
/// poll, the option, or the member.
model PollVote {
  id        String   @id @default(cuid())
  pollId    String
  optionId  String
  memberId  String
  createdAt DateTime @default(now())

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  member Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([pollId, memberId])
}

/// What a comment is attached to (#30). The comment thread is intentionally
/// polymorphic so ideas, activities, and polls share one model — this slice
/// wires only ideas in the UI, but the model already supports the rest with no
/// later migration.
enum CommentTarget {
  idea
  activity
  poll
}

/// A discussion comment (#30, v0.2.0), attached polymorphically to an idea,
/// activity, or poll via (`targetType`, `targetId`). `targetId` is a plain id,
/// not a relational FK — the target lives in a different table per `targetType`,
/// so referential integrity for the target is enforced in the action (the
/// target's existence is checked before a comment is created), not by the DB.
/// `author` is nullable (SetNull) so a comment outlives its poster's Member row
/// if they're removed. Indexed on (`targetType`, `targetId`) — the one access
/// path: "the thread for this target, in order."
model Comment {
  id         String        @id @default(cuid())
  targetType CommentTarget
  targetId   String
  authorId   String?
  body       String
  createdAt  DateTime      @default(now())

  author Member? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
}
